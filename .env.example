# Required — the Claude API key that powers the assistant brain.
# Get one at https://platform.claude.com. On employee machines prefer storing it
# in Windows Credential Manager instead:  jarvis secrets set anthropic
ANTHROPIC_API_KEY=

# Optional — API keys for external AI tools configured under `ai_tools:` in
# config.yaml. Each tool names its own env var via `api_key_env`.
# COMPANY_GPT_API_KEY=
